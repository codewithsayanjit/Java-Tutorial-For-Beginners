# =========================================================================
# Java Project Defaults
# =========================================================================
# Compiled class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machines crash logs
hs_err_pid*
replay_pid*

# Build Tools (Maven and Gradle)
target/
!.mvn/wrapper/maven-wrapper.jar
build/
.gradle/

# =========================================================================
# IDE Settings & Operating Systems
# =========================================================================
# IntelliJ IDEA
.idea/
*.iml

# Eclipse
.metadata/
.classpath
.project
.settings/

# OS Clutter
.DS_Store
Thumbs.db

# =========================================================================
# VS Code & JSON File Handling (Customized)
# =========================================================================
# Ignore the entire VS Code configuration folder
.vscode/

# OPTIONAL EXCEPTION: Uncomment the lines below if you want to allow 
# specific VS Code files (like debug launchers) to be shared in Git.
# !.vscode/launch.json
# !.vscode/extensions.json

# Ignore all JSON files project-wide (e.g., config data, temporary outputs)
*.json

# OPTIONAL EXCEPTION: Uncomment below if you need a specific JSON file tracked
# !important-config.json
